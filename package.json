{
	"name": "braga-chat",
	"version": "1.6.0",
	"description": "AI-powered assistant for Obsidian with inline editing and persistent chat",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"prebuild": "node scripts/concat-styles.mjs",
		"build": "node scripts/generate-version-info.js && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:e2e:watch": "vitest --config vitest.e2e.config.ts",
		"benchmarks": "npx tsx benchmarks/context-benchmark.ts",
		"benchmarks:generate": "npx tsx benchmarks/context-benchmark.ts --generate-fixtures",
		"preview:build": "node scripts/build-preview.mjs",
		"package": "pnpm run build && mkdir -p dist/chat-lab && cp main.js manifest.json styles.css dist/chat-lab/",
		"install:vault": "pnpm run build && mkdir -p ../../.obsidian/plugins/braga-chat && cp main.js manifest.json styles.css ../../.obsidian/plugins/braga-chat/",
		"version:generate": "node scripts/generate-version-info.js",
		"version:bump": "node version-bump.mjs && git add manifest.json versions.json",
		"version": "pnpm run version:bump",
		"relay": "node relay/relay-server.js",
		"relay:port": "node relay/relay-server.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"ai",
		"chat",
		"ollama",
		"openai"
	],
	"author": "space-cadet",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/fabhiansan/obsidian-braga-chat.git"
	},
	"bugs": {
		"url": "https://github.com/space-cadet/obsidian-ai/issues"
	},
	"homepage": "https://github.com/space-cadet/obsidian-ai#readme",
	"devDependencies": {
		"@ai-sdk/provider": "4.0.6",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/codemirror": "^5.60.15",
		"@types/node": "^20.19.41",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@typescript-eslint/eslint-plugin": "^8.11.0",
		"@typescript-eslint/parser": "^8.11.0",
		"@vitest/coverage-v8": "^4.1.7",
		"builtin-modules": "^4.0.0",
		"dotenv": "^17.4.2",
		"esbuild": "^0.25.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^15.5.2",
		"obsidian": "latest",
		"prettier": "^3.6.2",
		"typescript": "^5.6.3",
		"vitest": "^4.1.7"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,css,scss,md,json,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.34",
		"@ai-sdk/deepseek": "3.0.24",
		"@ai-sdk/google": "4.0.37",
		"@ai-sdk/openai": "4.0.34",
		"@codemirror/autocomplete": "^6.18.4",
		"@codemirror/commands": "^6.8.0",
		"@codemirror/state": "^6.5.1",
		"@codemirror/view": "^6.36.2",
		"@openrouter/ai-sdk-provider": "3.0.0",
		"@types/diff-match-patch": "^1.0.36",
		"ai": "7.0.56",
		"ajv": "^8.20.0",
		"diff-match-patch": "^1.0.5",
		"pdfjs-dist": "4.10.38",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zod": "^3.25.76"
	}
}
